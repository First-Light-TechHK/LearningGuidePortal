{
  "name": "learning-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --dns-result-order=ipv4first node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --dns-result-order=ipv4first node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit",
    "typecheck:io": "tsc --noEmit -p tsconfig.io.json",
    "lint": "eslint .",
    "test:auth": "NODE_OPTIONS=\"--require ./scripts/register-tsconfig-paths.cjs\" playwright test --config=playwright.auth.config.ts",
    "test:unit": "node --import tsx --require ./scripts/register-tsconfig-paths.cjs --test tests/unit/*.test.ts",
    "test:integration": "npm run test:auth",
    "test:e2e": "NODE_OPTIONS=\"--require ./scripts/register-tsconfig-paths.cjs\" playwright test --config=playwright.e2e.config.ts",
    "test:io": "node --import tsx --require ./scripts/register-tsconfig-paths.cjs --test --test-concurrency=1 tests/io/*.test.ts",
    "test:ci": "npx tsc --noEmit && npm run test:unit && npm run test:integration",
    "test:local": "npm run test:e2e && npm run smoke:product",
    "test:smoke:ci": "node scripts/smoke-product.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "smoke:product": "node scripts/smoke-product.mjs",
    "preflight:production": "node scripts/preflight-production.mjs",
    "stripe:listen": "stripe listen --forward-to http://127.0.0.1:3011/api/payment/webhook",
    "seed:science": "npx --yes tsx scripts/seed-science.ts",
    "verify:science-display": "node scripts/verify-science-display.mjs",
    "update:openrouter-model-limits": "node scripts/update-openrouter-model-limits.mjs",
    "test:payment": "playwright test --config=playwright.payment.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/client-sesv2": "^3.1101.0",
    "@fontsource/inter": "^5.3.0",
    "google-auth-library": "^11.0.2",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "next": "^15.0.4",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.4",
    "playwright": "^1.61.0",
    "tsconfig-paths": "^3.15.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  }
}

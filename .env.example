APP_ENV=DEV
APP_VERSION=local
STORAGE_BACKEND=local
PAYMENT_MODE=demo
LOCAL_SOCIAL_LOGIN=1
NEXT_PUBLIC_DEFAULT_LOCALE=en-GB
DATABASE_URL=
# Required for real Google/WeChat OAuth; use at least 32 random characters.
SESSION_SECRET=
BACKOFFICE_OPERATOR_EMAIL=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Learning Guide
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 only for Stripe sandbox runs; rejects live keys, prices and events.
STRIPE_SANDBOX=0
# Accepts a Stripe Price ID or a lookup key. Never put secret keys here.
STRIPE_PRICE_EVERYTHING_SIX_MONTHS=
STRIPE_PRICE_EVERYTHING_YEAR=
STRIPE_PRICE_CATE_EUROPEAN_HUMAN_SIX_MONTHS=
STRIPE_PRICE_CATE_EUROPEAN_HUMAN_YEAR=
STRIPE_PRICE_CATE_CHINESE_HUMAN_SIX_MONTHS=
STRIPE_PRICE_CATE_CHINESE_HUMAN_YEAR=
STRIPE_PRICE_CATE_SCIENCE_SIX_MONTHS=
STRIPE_PRICE_CATE_SCIENCE_YEAR=
NEXT_PUBLIC_APP_URL=http://localhost:3011
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SES_FROM_EMAIL=
# 163/SMTP sending. If SMTP_HOST, SMTP_USER and SMTP_PASS are set, mail is sent
# through SMTP instead of AWS SES. Do not commit SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_VERIFICATION_REQUIRED=1
AWS_REGION=ap-southeast-1
S3_BUCKET=
DATA_S3_BUCKET=

# Production must use APP_ENV=PPE/PROD, PAYMENT_MODE=stripe, PostgreSQL + S3,
# real OAuth credentials and an HTTPS NEXT_PUBLIC_APP_URL. Do not enable local
# social login or demo payment in PPE/PROD.
# To test real providers locally, keep APP_ENV=DEV and set PAYMENT_MODE=stripe,
# LOCAL_SOCIAL_LOGIN=0, the provider credentials and an exact callback origin
# in NEXT_PUBLIC_APP_URL. See docs/phase1/local-provider-testing.md.

STRIPE_PRICE_EVERYTHING_SIX_MONTHS=
STRIPE_PRICE_EVERYTHING_YEAR=
STRIPE_PRICE_CATE_EUROPEAN_HUMAN_SIX_MONTHS=
STRIPE_PRICE_CATE_EUROPEAN_HUMAN_YEAR=
STRIPE_PRICE_CATE_CHINESE_HUMAN_SIX_MONTHS=
STRIPE_PRICE_CATE_CHINESE_HUMAN_YEAR=
STRIPE_PRICE_CATE_SCIENCE_SIX_MONTHS=
STRIPE_PRICE_CATE_SCIENCE_YEAR=

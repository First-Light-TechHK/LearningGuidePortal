APP_ENV=DEV
APP_VERSION=local
STORAGE_BACKEND=local
PAYMENT_MODE=demo
LOCAL_SOCIAL_LOGIN=1
NEXT_PUBLIC_DEFAULT_LOCALE=en-GB
DATABASE_URL=
# Required for real Google/WeChat OAuth; use at least 32 random characters.
SESSION_SECRET=
BACKOFFICE_OPERATOR_EMAIL=
# Comma-separated hosts that may serve /backoffice. Defaults to
# admin.ilovelearningguide.com,admin.sit.ilovelearningguide.com
# (plus localhost in APP_ENV=DEV).
ADMIN_HOSTS=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Learning Guide
# AI Tutor now runs in KnowledgeSystem (2026-10-22). Portal proxies to KS;
# browser never sees this service token.
KS_TUTOR_BASE_URL=http://localhost:3000
# Set only when KS runs with AUTH_ENABLED=true (must equal KS AUTH_TOKEN).
KS_TUTOR_API_KEY=
KS_TUTOR_TIMEOUT_MS=60000
# Shared service token for KS pulling GET /api/integration/catalogue.
PORTAL_INTEGRATION_TOKEN=
# Helpdesk Tickets v1: shared Bearer token BackOffice (Admin server) sends to
# /api/integration/helpdesk/**. Read on every request, so rotation needs no
# restart. Unset -> those endpoints answer 503 integration_disabled.
PORTAL_HELPDESK_TOKEN=
# Helpdesk (Figma addendum): Portal -> Admin integration API for Common
# Questions, AI suggestions and their outcomes. Both are read per request.
# Unset -> the Common Questions column is hidden and no suggestion is offered
# (tickets are still created). Never commit real values.
ADMIN_HELPDESK_BASE_URL=
ADMIN_HELPDESK_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 only for Stripe sandbox runs; rejects live keys, prices and events.
STRIPE_SANDBOX=0
# Accepts a Stripe Price ID or a lookup key. Never put secret keys here.
STRIPE_PRICE_EVERYTHING_SIX_MONTHS=
STRIPE_PRICE_EVERYTHING_YEAR=
# Native upgrades use the same-term recurring Everything Price and Stripe proration.
# Optional compatibility for previously issued fixed-price upgrade orders only:
STRIPE_PRICE_UPGRADE_SIX_MONTHS=
STRIPE_PRICE_UPGRADE_ONE_YEAR=
STRIPE_PRICE_CATE_EUROPEAN_HUMAN_SIX_MONTHS=
STRIPE_PRICE_CATE_EUROPEAN_HUMAN_YEAR=
STRIPE_PRICE_CATE_CHINESE_HUMAN_SIX_MONTHS=
STRIPE_PRICE_CATE_CHINESE_HUMAN_YEAR=
STRIPE_PRICE_CATE_SCIENCE_SIX_MONTHS=
STRIPE_PRICE_CATE_SCIENCE_YEAR=
NEXT_PUBLIC_APP_URL=http://localhost:3011
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Single-domain website login; set origins on DEV, SIT and UAT.
WECHAT_AUTH_ORIGIN=
WECHAT_DEV_ORIGIN=
WECHAT_SIT_ORIGIN=
WECHAT_UAT_ORIGIN=
# Same 32+ character secret on all three services.
WECHAT_SHARED_STATE_SECRET=
# Different 32+ character secret per environment; UAT holds all three.
WECHAT_DEV_HANDOFF_SECRET=
WECHAT_SIT_HANDOFF_SECRET=
WECHAT_UAT_HANDOFF_SECRET=
SES_FROM_EMAIL=
# 163/SMTP sending. If SMTP_HOST, SMTP_USER and SMTP_PASS are set, mail is sent
# through SMTP instead of AWS SES. Do not commit SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_VERIFICATION_REQUIRED=1
AWS_REGION=ap-southeast-1
S3_BUCKET=
DATA_S3_BUCKET=

# Production must use APP_ENV=PPE/PROD, PAYMENT_MODE=stripe, PostgreSQL + S3,
# real OAuth credentials and an HTTPS NEXT_PUBLIC_APP_URL. Do not enable local
# social login or demo payment in PPE/PROD.
# To test real providers locally, keep APP_ENV=DEV and set PAYMENT_MODE=stripe,
# LOCAL_SOCIAL_LOGIN=0, the provider credentials and an exact callback origin
# in NEXT_PUBLIC_APP_URL. See docs/phase1/local-provider-testing.md.

# LiveKit project registry. Keep only non-secret ids/endpoints and Secrets Manager references here.
# Example: [{"id":"eu-primary","url":"wss://project.livekit.cloud","region":"eu-central","state":"active","weight":1,"credentialSecretId":"learning-guide/livekit/eu-primary"}]
# Local dev (Docker): docker run --rm -p 7880:7880 -p 7881:7881 -p 7882:7882/udp livekit/livekit-server --dev --bind 0.0.0.0
# then use:
# LIVEKIT_PROJECTS_JSON=[{"id":"local","url":"ws://127.0.0.1:7880","state":"active","weight":1,"credentialSecretId":"local/livekit"}]
# LIVEKIT_LOCAL_CREDENTIALS_JSON={"local/livekit":{"apiKey":"devkey","apiSecret":"secret"}}
LIVEKIT_PROJECTS_JSON=
# Hot alternative (SIT/UAT/PROD): a Secrets Manager secret id whose value is the same JSON. Read at run time with a
# one-minute cache, so adding, changing or draining a project needs no redeploy; when set, LIVEKIT_PROJECTS_JSON is ignored.
LIVEKIT_PROJECTS_SECRET_ID=
# DEV only: local values keyed by credentialSecretId. Never enable this in SIT/UAT/PPE/PROD.
LIVEKIT_LOCAL_CREDENTIALS_JSON=
# The Study Group (Live Session) AI Tutor is KnowledgeSystem's: its prompt, model, keys and advisory quota
# live in KS. Portal only needs KS_TUTOR_BASE_URL / KS_TUTOR_API_KEY above.
# Model id read by the course tutor (not the Study Group tutor). Empty uses openrouter/auto.
OPENROUTER_MODEL=
# 32-byte key, base64. Used only to encrypt token-issuance log lines. Not the LiveKit secret.
STUDY_GROUP_TOKEN_LOG_KEY=

STRIPE_PRICE_EVERYTHING_SIX_MONTHS=
STRIPE_PRICE_EVERYTHING_YEAR=
STRIPE_PRICE_CATE_EUROPEAN_HUMAN_SIX_MONTHS=
STRIPE_PRICE_CATE_EUROPEAN_HUMAN_YEAR=
STRIPE_PRICE_CATE_CHINESE_HUMAN_SIX_MONTHS=
STRIPE_PRICE_CATE_CHINESE_HUMAN_YEAR=
STRIPE_PRICE_CATE_SCIENCE_SIX_MONTHS=
STRIPE_PRICE_CATE_SCIENCE_YEAR=
